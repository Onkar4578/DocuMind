# --- LLM provider: "groq" (default, free) or "anthropic" (Claude, paid) ---
LLM_PROVIDER=groq

# Only fill in the key for whichever provider you set above.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ANTHROPIC_API_KEY=        # only needed if LLM_PROVIDER=anthropic

# --- Qdrant: leave blank for embedded/local mode (no server needed) ---
QDRANT_URL=

# --- Postgres (document registry) ---
# For docker-compose, this is overridden automatically - only needed for local (non-docker) runs.
DATABASE_URL=postgresql://docmind:docmind@localhost:5432/docmind

# --- Rate limiting (per client IP) ---
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_QUERY=15/minute

# --- Optional API-key gate for public deployments ---
# Set REQUIRE_API_KEY=true and pick a secret; clients must send header X-API-Key: <value>
REQUIRE_API_KEY=false
API_ACCESS_KEY=
